{
  "name": "xbox-ai-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite preview --host 0.0.0.0 --port 4173",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src tests docs data scripts/*.ts",
    "format:check": "prettier --check src tests docs data scripts/*.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "audit:links": "node --import tsx scripts/check-internal-links.ts",
    "audit:external-links": "node --import tsx scripts/check-external-links.ts",
    "audit:performance": "lhci autorun && node --import tsx scripts/assert-lighthouse-medians.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.6",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "minimatch": "11.0.5"
  }
}
